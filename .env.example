# Public URL of the app (used for OAuth redirect, Origin checks, and as the
# Caddyfile's site address when deploying with Docker + Caddy)
BASE_URL=http://localhost:5173
PORT=3000
HOST=127.0.0.1

# Google OAuth client (Web application). Redirect URI: ${BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SQLite file location
DATABASE_PATH=./data/planner.db

# Comma-separated list of email addresses (case-insensitive) allowed to see
# /admin. Leave blank to disable the admin dashboard entirely.
ADMIN_EMAILS=

# Local-only passwordless login for testing sync without Google. Never enable in production.
DEV_LOGIN=false

# DuckDNS dynamic DNS updater (optional - only used by the "duckdns" container,
# started with `docker compose --profile duckdns up -d`). Get these from your
# subdomain's page at https://www.duckdns.org.
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
# Optional: keeps this TXT record (e.g. a Google Search Console
# "google-site-verification=..." value) refreshed automatically. Leave blank
# to not manage a TXT record.
DUCKDNS_TXT=
