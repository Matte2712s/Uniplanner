# Public URL of the app (used for OAuth redirect and Origin checks)
BASE_URL=http://localhost:5173
PORT=3000
HOST=127.0.0.1

# Google OAuth client (Web application). Redirect URI: ${BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SQLite file location
DATABASE_PATH=./data/planner.db

# Local-only passwordless login for testing sync without Google. Never enable in production.
DEV_LOGIN=false
